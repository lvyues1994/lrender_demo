cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED DEMO_DEPENDENCY_ROOT)
  get_filename_component(DEMO_DEPENDENCY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED DEMO_DEPENDENCY_LOCK)
  set(DEMO_DEPENDENCY_LOCK "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json")
endif()
find_package(Git REQUIRED QUIET)
file(REAL_PATH "${DEMO_DEPENDENCY_ROOT}" dependency_root)
if(NOT EXISTS "${DEMO_DEPENDENCY_LOCK}")
  message(FATAL_ERROR "Missing dependency lock: ${DEMO_DEPENDENCY_LOCK}")
endif()
file(READ "${DEMO_DEPENDENCY_LOCK}" lock_json)
string(JSON record_count LENGTH "${lock_json}" records)
if(record_count LESS 1)
  message(FATAL_ERROR "Empty dependency lock")
endif()
math(EXPR last_record "${record_count} - 1")
foreach(index RANGE 0 ${last_record})
  foreach(field IN ITEMS path url branch sha upstreamPin)
    string(JSON ${field} GET "${lock_json}" records ${index} ${field})
  endforeach()
  if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)")
    message(FATAL_ERROR "Unsafe dependency path: ${path}")
  endif()
  set(checkout "${dependency_root}/${path}")
  if(NOT IS_DIRECTORY "${checkout}")
    message(FATAL_ERROR "Missing dependency directory: ${path}")
  endif()
  file(REAL_PATH "${checkout}" checkout)
  cmake_path(IS_PREFIX dependency_root "${checkout}" NORMALIZE inside_root)
  if(NOT inside_root)
    message(FATAL_ERROR "Unsafe dependency path: ${path}")
  endif()
  string(LENGTH "${sha}" sha_length)
  if(NOT sha_length EQUAL 40 OR NOT sha MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Invalid locked SHA: ${path}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${checkout}" rev-parse --show-toplevel
    RESULT_VARIABLE git_result OUTPUT_VARIABLE git_root ERROR_VARIABLE git_error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT git_result EQUAL 0)
    message(FATAL_ERROR "Not a Git checkout: ${path}: ${git_error}")
  endif()
  file(REAL_PATH "${git_root}" git_root)
  if(NOT git_root STREQUAL checkout)
    message(FATAL_ERROR "Not a Git checkout: ${path} (belongs to ancestor repository)")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${checkout}" rev-parse HEAD
    RESULT_VARIABLE git_result OUTPUT_VARIABLE actual_sha ERROR_VARIABLE git_error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT git_result EQUAL 0 OR NOT actual_sha STREQUAL sha)
    message(FATAL_ERROR "SHA mismatch: ${path}: locked ${sha}, actual ${actual_sha}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${checkout}" status --porcelain=v1 --untracked-files=all
    RESULT_VARIABLE git_result OUTPUT_VARIABLE dirty ERROR_VARIABLE git_error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT git_result EQUAL 0 OR NOT dirty STREQUAL "")
    message(FATAL_ERROR "Dirty dependency: ${path}: ${dirty} ${git_error}")
  endif()
endforeach()
message(STATUS "Dependency lock verified: ${record_count}")
